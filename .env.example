# Copy this file to .env and fill in your real values (never commit .env).

# OAuth 2.0 Client ID (Google Cloud Console > APIs & Services > Credentials)
BLOGGER_CLIENT_ID=

# OAuth 2.0 Client Secret (same credentials page)
BLOGGER_CLIENT_SECRET=

# Refresh token generated once by scripts/get_refresh_token.py
BLOGGER_REFRESH_TOKEN=

# Numeric Blogger blog ID (from the blog URL in the Blogger dashboard)
BLOGGER_BLOG_ID=

# Google Gemini API key (Google AI Studio) for content generation
GEMINI_API_KEY=

# Gemini model name (optional, has a sensible default in generate_post.py)
GEMINI_MODEL=

# Pexels API key (https://www.pexels.com/api/) for post photos
PEXELS_API_KEY=

# "true" = save as draft, "false" = publish live. Default is "true".
AS_DRAFT=true

# "true" = do everything except the real API call. Default is "false".
DRY_RUN=false
